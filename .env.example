# ============================================================================
# Oply — environment configuration
#
# Copy to `.env.local` and fill in. Never commit the real file.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Server only. Never expose this to the
# browser and never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ------------------------------------------------------------
# Anthropic is the shipped provider. AI_PROVIDER selects the implementation in
# lib/ai/client.ts; adding another means adding a class there.
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional model override. Defaults to claude-opus-5.
AI_MODEL=claude-opus-5

# --- Crypto payments --------------------------------------------------------
# The shipped provider is NOWPayments. CRYPTO_PAYMENT_PROVIDER selects the
# implementation in lib/payments/index.ts.
CRYPTO_PAYMENT_PROVIDER=nowpayments
CRYPTO_PAYMENT_API_KEY=
CRYPTO_PAYMENT_SECRET=
# IPN secret used to verify webhook signatures. Required — without it every
# webhook is rejected, which is the safe default.
CRYPTO_PAYMENT_WEBHOOK_SECRET=
# Optional: override the provider API base URL.
# CRYPTO_PAYMENT_API_URL=https://api.nowpayments.io/v1

# Development-only payment simulator. Ignored unless NODE_ENV is not
# "production". Never set this on a production deployment.
DEV_PAYMENT_MODE=false

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://oply.me
SUPPORT_EMAIL=support@oply.me

# --- Analytics (optional) ---------------------------------------------------
# Leave unset to collect nothing. When set, only event names and non-sensitive
# properties are recorded — never prompt text or generated output.
ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_ENABLED=

# --- Admin reporting (optional) ---------------------------------------------
# Assumed payment-provider fee rate, used only for the estimated margin figure
# on the admin dashboard. Not a billed number.
PAYMENT_FEE_RATE=0.01
